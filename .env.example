# Keep static as the default and rollback value until the HP-OS path is accepted.
MASS_EVENT_SOURCE=static

# Server-only HP-OS settings used when MASS_EVENT_SOURCE=hpos.
HPOS_API_BASE_URL=http://localhost:3000
HPOS_SITE_ID=site_mass_local
# Optional; never prefix this with NEXT_PUBLIC_ or expose it to browser code.
HPOS_SITE_CREDENTIAL=
